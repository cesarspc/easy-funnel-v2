# Variable names + safe placeholder examples only. Never commit real secrets.
# Configure actual values via Koyeb (backend) / Cloudflare Pages (frontend) env settings.

# --- Neon PostgreSQL (via Prisma) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://example-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=example-token

# --- Cloudflare R2 (image storage) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=example-access-key
R2_SECRET_ACCESS_KEY=example-secret-key
R2_BUCKET=cod-commerce-images
R2_PUBLIC_HOST=https://images.example.com

# --- JWT / Administrator sessions ---
JWT_SECRET=example-signing-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=cod-commerce-platform
JWT_AUDIENCE=cod-commerce-admin

# --- GeoIP (self-hosted GeoLite2) ---
GEOIP_DATABASE_PATH=/app/geoip/GeoLite2-Country.mmdb
GEOIP_UPDATE_URL=https://example-geoip-provider/GeoLite2-Country.mmdb

# --- Deployment ---
APP_VERSION=0.1.0
ENVIRONMENT=development

# --- Frontend (build-time, no secrets — public values only) ---
VITE_API_BASE_URL=/api
