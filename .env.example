# Variable names + safe placeholder examples only. Never commit real secrets.
# Configure actual values via Koyeb (backend) / Cloudflare Pages (frontend) env settings.

# --- Neon PostgreSQL (via Prisma) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Cloudflare R2 (image storage) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=example-access-key
R2_SECRET_ACCESS_KEY=example-secret-key
R2_BUCKET=cod-commerce-images
R2_PUBLIC_HOST=https://images.example.com

# Prefer these vendor-neutral names for S3, MinIO, R2, or compatible storage.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=example-access-key
S3_SECRET_ACCESS_KEY=example-secret-key
S3_BUCKET=store
S3_PUBLIC_BASE_URL=http://localhost:8088/media

# --- JWT / Administrator sessions ---
JWT_SECRET=example-signing-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=cod-commerce-platform
JWT_AUDIENCE=cod-commerce-admin

# --- GeoIP (self-hosted GeoLite2) ---
GEOIP_DATABASE_PATH=/app/geoip/GeoLite2-Country.mmdb
GEOIP_UPDATE_URL=https://example-geoip-provider/GeoLite2-Country.mmdb

# --- MasterShop fulfillment (bootstrap only) ---
# Seeded into the database on first start; afterwards provider, URL, timeout
# and API key are edited under Admin -> Tienda (the key is write-only there).
# Never expose it to the frontend.
MASTERSHOP_API_KEY=
MASTERSHOP_ORDERS_URL=https://prod.api.mastershop.com/api/orders
MASTERSHOP_TIMEOUT_SECONDS=5
FULFILLMENT_PROVIDER=none

# --- Store bootstrap (used only when the singleton row does not exist) ---
STORE_NAME=Mi Tienda
STORE_LEGAL_NAME=
STORE_PRIMARY_COLOR=#30503b
STORE_WHATSAPP_NUMBER=
STORE_WHATSAPP_MESSAGE=Hola, me gustaría conocer más sobre tus productos.
STORE_SUPPORT_EMAIL=
# Market conventions (locale, currency, time zone, phone rules).
STORE_COUNTRY_CODE=CO
STORE_LOCALE=es-CO
STORE_CURRENCY=COP
STORE_TIME_ZONE=America/Bogota
STORE_PHONE_COUNTRY_CODE=57
STORE_PHONE_NATIONAL_PATTERN=3[0-9]{9}

# --- Admin bootstrap ---
# When both are set, startup creates this Administrator if it does not exist.
# An existing account is NOT modified, so a restart never reverts a rotated
# password. Set ADMIN_PASSWORD_RESET=true for one deploy to force a rotation,
# then set it back to false. Minimum password length is 12.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-12-chars
ADMIN_PASSWORD_RESET=false

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Deployment ---
APP_VERSION=0.1.0
ENVIRONMENT=development

# --- Frontend (build-time, no secrets — public values only) ---
VITE_API_BASE_URL=/api
