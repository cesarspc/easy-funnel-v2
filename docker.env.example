POSTGRES_USER=easy_funnel
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=easy_funnel
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_ROOT_USER=easy-funnel-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
APP_PUBLIC_URL=http://localhost:8088
APP_SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443
ACME_EMAIL=admin@example.com
STORE_NAME=Mi Tienda
STORE_LEGAL_NAME=
STORE_PRIMARY_COLOR=#30503b
STORE_WHATSAPP_NUMBER=
STORE_WHATSAPP_MESSAGE=Hola, me gustaría conocer más sobre tus productos.
STORE_SUPPORT_EMAIL=
# Market conventions, seeded once and then edited under Admin -> Tienda.
STORE_COUNTRY_CODE=CO
STORE_LOCALE=es-CO
STORE_CURRENCY=COP
STORE_TIME_ZONE=America/Bogota
STORE_PHONE_COUNTRY_CODE=57
STORE_PHONE_NATIONAL_PATTERN=3[0-9]{9}
# Fulfillment, seeded once and then edited under Admin -> Tienda.
FULFILLMENT_PROVIDER=none
MASTERSHOP_API_KEY=
MASTERSHOP_ORDERS_URL=https://prod.api.mastershop.com/api/orders
MASTERSHOP_TIMEOUT_SECONDS=5

