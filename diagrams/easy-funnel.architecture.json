        "label": "Buyer request path",
        "focus": [
          "buyer",
          "spa",
          "api"
        ],
        "note": "The SPA is static hosting, so every call it makes crosses an origin into the API."
      },
      {
        "id": "order-authority",
        "label": "Order authority",
        "focus": [
          "api",
          "neon",
          "upstash",
          "geoip"
        ],
        "note": "Every fraud check runs synchronously inside the transaction that persists the order."
      },
      {
        "id": "automation",
        "label": "Automation door",
        "focus": [
          "automation",
          "api",
          "neon"
        ],
        "note": "A separate shared key reaches two endpoints only, and never the admin API."
      },
      {
        "id": "fulfillment",
        "label": "Fulfillment hand-off",
        "focus": [
          "api",
          "neon",
          "mastershop"
        ],
        "note": "The hand-off runs after the local commit, so acceptance never depends on a third party."
      }
    ]
