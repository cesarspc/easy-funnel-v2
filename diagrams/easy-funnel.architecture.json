  "cards": [
    {
      "dot": "emerald",
      "title": "Local order authority",
      "items": [
        "Duplicate, blacklist, rate-limit and GeoIP checks run synchronously",
        "One transaction persists the order with its fraud flags, or nothing",
        "An order is accepted as pending or flagged_fraud, never dropped"
      ]
    },
    {
      "dot": "violet",
      "title": "Layers inside the monolith",
      "items": [
        "Routers stay thin: schemas, auth dependency, error mapping",
        "Services own transactions, I/O order and audit writes",
        "Domains are pure functions; repositories own every Prisma query"
      ]
    },
    {
      "dot": "amber",
      "title": "Deliberate degradation",
      "items": [
        "Unreachable Redis returns a non-triggering result; durable checks still run",
        "A missing GeoIP database skips geo rules instead of rejecting orders",
        "A failed fulfillment hand-off is recorded and retryable, never fatal"
      ]
    }
  ]
