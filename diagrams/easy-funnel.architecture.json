        "id": "buyer-path",
        "label": "Buyer request path",
        "focus": [
          "buyer",
          "caddy",
          "spa",
          "api"
        ],
        "note": "A buyer arrives from an ad on a phone. Caddy serves the SPA and proxies the API it calls."
      },
      {
        "id": "order-authority",
        "label": "Order authority",
        "focus": [
          "api",
          "postgres",
          "redis",
          "geoip"
        ],
        "note": "Every fraud check runs synchronously inside the transaction that persists the order."
      },
      {
        "id": "media",
        "label": "Image delivery",
        "focus": [
          "api",
          "storage",
          "caddy",
          "buyer"
        ],
        "note": "Variants are generated on upload and served back through the same edge under /media."
      },
      {
        "id": "fulfillment",
        "label": "Fulfillment hand-off",
        "focus": [
          "api",
          "postgres",
          "mastershop"
        ],
        "note": "The hand-off runs after the local commit, so acceptance never depends on a third party."
      }
    ]
