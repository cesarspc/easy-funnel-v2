# Environment / secrets — never commit actual values.
.env
.env.*
!.env.example

# Backend (Python)
backend/.venv/
backend/**/__pycache__/
backend/**/*.pyc
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/htmlcov/
backend/.coverage

# Prisma generated client (regenerated via `prisma generate`, never hand-edited)
backend/app/generated/

# GeoIP licensed database files — never committed, provisioned at build/deploy time.
infrastructure/geoip/*.mmdb

**/uploads/
**/*.sqlite3

# Editor / OS
.DS_Store
Thumbs.db

*.md
*.log
*.bat
*.ps1
!README.md

# Test output files
frontend/test_output*.txt
output_check.txt
live_err.txt
frontend/vite_out.log
frontend/vite_start.log

.kiro/
.agents/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.impeccable/
.hypothesis/
docs/
infrastructure/
specs/

# Python egg-info
*.egg-info/